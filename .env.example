# MTA GTFS-Realtime feed URL for the numbered lines (1/2/3/4/5/6/S).
# ASSUMPTION (unverified from this environment -- no network access at
# generation time): this is MTA's documented feed endpoint as of the last
# time it was checked. MTA's real-time feeds no longer require an API key
# (removed 2024), but endpoint paths have changed before. Verify against
# https://www.mta.info/developers before relying on this in production.
GTFS_FEED_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs

# Ingestion loop tuning (see ADR-001 in ARCHITECTURE.md for why these
# defaults were chosen). Safe to omit -- these are the code's own defaults.
POLL_INTERVAL_SECONDS=30
RUN_DURATION_SECONDS=480
